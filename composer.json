{
    "name": "mradder/filament-logger",
    "description": "Audit logging, activity tracking, exports, alerts, and dashboards for Filament admin panels.",
    "keywords": [
        "activity-log",
        "activity-tracking",
        "admin-panel",
        "alerts",
        "audit-log",
        "compliance",
        "filament",
        "filament-logger",
        "filamentphp",
        "exports",
        "laravel",
        "laravel-activitylog",
        "security",
        "spatie-activitylog"
    ],
    "homepage": "https://mradder.github.io/filament-logger/",
    "support": {
        "docs": "https://mradder.github.io/filament-logger/",
        "issues": "https://github.com/MrAdder/filament-logger/issues",
        "source": "https://github.com/MrAdder/filament-logger"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Ziyaan Hassan",
            "email": "ziyaan2010@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Daniel Green",
            "email": "dgreen03@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.0 || ^4.3.1 || ^5.0",
        "illuminate/contracts": "^11.0 | ^12.0 | ^13.0",
        "spatie/laravel-activitylog": "^4.5",
        "spatie/laravel-package-tools": "^1.13.5"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "1.30.4",
        "nunomaduro/collision": "^8.0 | ^9.0 | ^10.0",
        "orchestra/testbench": "^9.0 | ^10.0 | ^11.0",
        "pestphp/pest": "^3.7 | ^4.0",
        "pestphp/pest-plugin-laravel": "^3.1 | ^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5 | ^12.5.22",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "MrAdder\\FilamentLogger\\": "src",
            "MrAdder\\FilamentLogger\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MrAdder\\FilamentLogger\\Tests\\": "tests"
        }
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.gitattributes",
            "/.gitignore",
            "/bootstrap",
            "/build",
            "/composer.lock",
            "/docs",
            "/package.json",
            "/package-lock.json",
            "/phpstan-baseline.neon",
            "/pint.json",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/testbench.yaml",
            "/tests"
        ]
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MrAdder\\FilamentLogger\\FilamentLoggerServiceProvider"
            ],
            "aliases": {
                "FilamentLogger": "MrAdder\\FilamentLogger\\Facades\\FilamentLogger"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
