# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Keep the distributed package to runtime files only.
#
# This list is the source of truth for what ships. Packagist builds its dist
# archive from the GitHub tarball, which honours export-ignore, so any entry
# added here must also be added to "archive.exclude" in composer.json for
# `composer archive` to agree.
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.github                export-ignore
/.gitignore             export-ignore
/art                    export-ignore
/bootstrap              export-ignore
/build                  export-ignore
/composer.lock          export-ignore
/docs                   export-ignore
/package-lock.json      export-ignore
/package.json           export-ignore
/phpstan-baseline.neon  export-ignore
/phpstan-filament3.neon.dist export-ignore
/phpstan.neon.dist      export-ignore
/phpunit.xml.dist       export-ignore
/pint.json              export-ignore
/tests                  export-ignore
